# Database (PostgreSQL via Prisma ORM)
# Works with local PostgreSQL, Docker, Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lockin?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lockin?schema=public"

# Authentication (Auth.js / NextAuth v5)
# Generate a strong secret: openssl rand -base64 33
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth Providers
# Obtain credentials from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
